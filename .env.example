# ARASTAT GUI Server Configuration

# The port the Express/Socket.io server will listen on
PORT=3000

# The path to the physical serial port connected to the potentiostat
# On macOS, typical paths look like: /dev/tty.usbmodem101 or /dev/cu.usbmodem101
# On Linux, typical paths look like: /dev/ttyACM0
# On Windows, typical paths look like: COM3
# Set to AUTO to automatically detect the first connected microcontroller/USB-serial port.
SERIAL_PORT=AUTO

# Baud rate for serial communication
BAUD_RATE=115200

# Set to true to run in mock simulation mode (generates simulated Cyclic Voltammetry scans)
# Highly recommended for testing the interface without hardware connected.
MOCK_SERIAL=true
